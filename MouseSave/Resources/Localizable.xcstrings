    "App Exclusion List (Game Mode)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式排除名單（遊戲模式）"
          }
        }
      }
    },
    "When these apps/games are in the foreground, MouseSave is completely paused for raw, precise mouse response." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當這些軟體或遊戲處於前景視窗時，MouseSave 將完全暫停，提供零延遲的原生滑鼠操作。"
          }
        }
      }
    },
    "Enter process name (e.g. cs2)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入應用程式名稱 (例如 cs2)"
